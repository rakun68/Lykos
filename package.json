{
  "name": "lykos",
  "version": "0.0.1",
  "description": "A strong, customizable coding agent built on the Pi runtime.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "lykos": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ledger-assets.mjs",
    "dev": "tsx lykos/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lykos/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ast-grep/napi": "0.45.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "^13.0.3",
    "linkedom": "0.18.13",
    "turndown": "7.2.4",
    "typebox": "^1.3.7",
    "vscode-jsonrpc": "9.0.2",
    "vscode-languageserver-protocol": "3.18.3",
    "yaml": "^2.7.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/turndown": "5.0.6",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-language-server": "6.0.0",
    "vitest": "5.0.3"
  }
}
